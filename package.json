{
  "name": "lendingpad-web-ui-engineer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "json-server --watch src/mocks/db.json --port 3001",
    "dev:all": "concurrently -n vite,api -c blue,green \"vite\" \"json-server --watch src/mocks/db.json --port 3001\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "json-server": "^1.0.0-beta.15",
    "sass": "^1.100.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "yarn@4.16.0",
  "engines": {
    "npm": "Please use Yarn instead.",
    "yarn": ">=4.0.0"
  }
}
